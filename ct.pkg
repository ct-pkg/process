# process - the POSIX subprocess execution package.
#
# OO surface: `Process` owns one child execution. Configuration methods take
# the receiver; `run()` executes synchronously and fills a read-only result
# object; `Drop` closes pipes and frees captured buffers. The package never
# invokes a shell, a PTY or job control.
#
# Platform: POSIX only (macOS / Linux). Windows is out of scope for this round.
# The binding is a `.m.ct` + `.shim.h` pair over libc; there is no external C
# library and therefore no `ldflags`.
#
# Requires the compiler line that ships static inherent methods
# (`impl T { static T *new(); }`, Phase 34) and `atomic T` (Phase 41). The floor
# is 0.44.1, the latest CT release at the time of writing, so both capabilities
# are already covered; the concurrency cap may stay in CT code or live in the
# C shim.
name = process
publisher = ct
ns-root = .
version = 0.1.1
licence = MIT
requires = ct >= 0.44.1
